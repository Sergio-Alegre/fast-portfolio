<footer class="footer">
  <div class="footer-content">
    <p class="copyright">
      &copy;{{ year }} {{ site.copyrightHolder }}
      {%- for item in site.legal %} · <a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}
    </p>
    <ul class="footer-links">
      {%- for item in site.social %}
      <li>
        {%- if item.icon %}
        <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" title="{{ item.label }}" aria-label="{{ item.label }}">
          <img src="/images/social/{{ item.icon }}.svg" alt="" class="social-icon" width="20" height="20" />
        </a>
        {%- else %}
        <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.label }}</a>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </div>
</footer>
