{
  "name": "fast-portfolio",
  "version": "0.1.0",
  "description": "Fast, static photography portfolio template for Eleventy. Export your photos into a folder and the gallery builds itself.",
  "license": "MIT",
  "author": "Sergio Alegre Vicente",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sergio-Alegre/fast-portfolio.git"
  },
  "keywords": [
    "eleventy",
    "11ty",
    "photography",
    "portfolio",
    "gallery",
    "avif",
    "static-site"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "rebuild": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^6.0.4",
    "justified-layout": "^4.1.0",
    "photoswipe": "^5.4.4",
    "sharp": "^0.34.3"
  }
}
